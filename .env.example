# ── Site public ────────────────────────────────────────────────
# URL publique du site (sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# ── Base de données (Supabase PostgreSQL) ─────────────────────
# Exécution (Vercel) : pooler en mode « Transaction » (port 6543).
# Mot de passe : si il contient des caractères spéciaux (@ : / ? # %), il doit être encodé en URL.
DATABASE_URL=postgresql://postgres.VOTRE_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations / sauvegardes : connexion « Session pooler » (port 5432). Si absent, DATABASE_URL est utilisé.
DATABASE_URL_DIRECT=postgresql://postgres.VOTRE_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optionnel : vérifier le certificat TLS du serveur (true) — voir docs/DEPLOYMENT.md
# DATABASE_SSL_VERIFY=false
# DATABASE_POOL_MAX=3

# ── E-mails (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ── Tests (base locale uniquement, JAMAIS la production) ───────
# TEST_DATABASE_URL=postgres://postgres:[MOT-DE-PASSE]@localhost:5432/postgres

# ── Administration (CMS) ───────────────────────────────────────
# Compte unique : l'e-mail doit correspondre à la ligne de la table `admin`.
ADMIN_EMAIL=warrenhkr@gmail.com
# Hash scrypt du mot de passe — généré par `npm run admin:init` ou `npm run admin:reset`
# (les deux commandes écrivent le mot de passe en clair dans ~/admin-portfolio-password.txt, chmod 600)
ADMIN_PASSWORD_HASH=
# Clé de chiffrement du secret TOTP : 32 octets en base64 — générée par `npm run admin:keys`
# ATTENTION : la perdre rend le second facteur invérifiable (récupération via `npm run admin:reset`)
ADMIN_TOTP_KEY=
